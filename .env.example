# ══════════════════════════════════════════════════════
#  ORA Backend — Template de configuration
#  Copier ce fichier en .env et remplir les valeurs
#  NE JAMAIS commiter le .env (seulement .env.example)
# ══════════════════════════════════════════════════════
ENVIRONMENT=development
# ENVIRONMENT=production

# ──────────────────────────────────────────────────────
#  DÉVELOPPEMENT
# ──────────────────────────────────────────────────────

DEV_SECRET_KEY=changez-cette-valeur-par-une-cle-aleatoire-longue
DEV_DEBUG=True
DEV_ALLOWED_HOSTS=localhost,127.0.0.1

DEV_DB_NAME=ora_db
DEV_DB_USER=postgres
DEV_DB_PASSWORD=votre_mot_de_passe_db
DEV_DB_HOST=localhost
DEV_DB_PORT=5432

DEV_EMAIL_HOST_USER=votre_email@gmail.com
DEV_EMAIL_HOST_PASSWORD=votre_app_password_gmail
DEV_DEFAULT_FROM_EMAIL=ORA Mentorat <votre_email@gmail.com>

DEV_FRONTEND_URL=http://localhost:5173
DEV_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173


# ──────────────────────────────────────────────────────
#  PRODUCTION  (à remplir quand le serveur sera prêt)
# ──────────────────────────────────────────────────────

PROD_SECRET_KEY=
PROD_DEBUG=False
PROD_ALLOWED_HOSTS=

PROD_DB_NAME=ora_db
PROD_DB_USER=postgres
PROD_DB_PASSWORD=
PROD_DB_HOST=localhost
PROD_DB_PORT=5432

PROD_EMAIL_HOST_USER=
PROD_EMAIL_HOST_PASSWORD=
PROD_DEFAULT_FROM_EMAIL=ORA Mentorat <noreply@votre-domaine.fr>

PROD_FRONTEND_URL=
PROD_CORS_ALLOWED_ORIGINS=
